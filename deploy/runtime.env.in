# Public, non-secret configuration only. Never put exchange keys/passwords here.
BOT_DATABASE_URL=sqlite:////var/lib/futures-platform/platform.sqlite3
BOT_MODE=paper
BOT_EXCHANGE_ENVIRONMENT=testnet
BOT_LIVE_TRADING_ENABLED=false
BOT_REPORTING_TIMEZONE=America/Bogota
BOT_DASHBOARD_ENABLED=true
BOT_PUBLIC_ORIGIN=https://@LAN_NAME@
BOT_SECURE_COOKIES=true
BOT_FRONTEND_DIRECTORY=@APP_ROOT@/frontend/dist
BOT_SESSION_LIFETIME_SECONDS=28800
