#!/sbin/openrc-run
# OpenRC init script for Binance Futures Bot
# Copy to /etc/init.d/futures-bot and chmod +x
# Edit /etc/conf.d/futures-bot with your configuration

description="Binance Futures Trading Bot"

: ${BOT_USER:="YOUR_USER"}
: ${BOT_GROUP:="YOUR_USER"}
: ${BOT_DIR:="/home/YOUR_USER/github/binance-futures-bot"}
: ${BOT_VENV:="${BOT_DIR}/.venv"}
: ${BOT_COMMAND:="run-web"}
: ${BOT_LOG:="/var/log/futures-bot.log"}
: ${BOT_PIDFILE:="/var/run/futures-bot.pid"}

pidfile="${BOT_PIDFILE}"

depend() {
    need localmount
    after bootmisc
    need net
    use dns
}

start_pre() {
    # Ensure log file and directory exist
    local logdir=$(dirname "${BOT_LOG}")
    if [ ! -d "$logdir" ]; then
        mkdir -p "$logdir" || return 1
    fi
    
    if [ ! -f "${BOT_LOG}" ]; then
        touch "${BOT_LOG}" || return 1
    fi
    
    # Set correct permissions
    chown "${BOT_USER}:${BOT_GROUP}" "${BOT_LOG}" 2>/dev/null
    chmod 640 "${BOT_LOG}" 2>/dev/null
    
    # Clean up stale pidfile if process isn't running
    if [ -f "${pidfile}" ]; then
        local pid=$(cat "${pidfile}")
        if ! kill -0 "${pid}" 2>/dev/null; then
            rm -f "${pidfile}"
        fi
    fi
}

start() {
    ebegin "Starting ${description}"
    
    if [ -f "${pidfile}" ]; then
        local pid=$(cat "${pidfile}")
        if kill -0 "${pid}" 2>/dev/null; then
            eend 1 "Already running"
            return 1
        fi
    fi
    
    # Export config variables for the wrapper script
    export BOT_USER BOT_GROUP BOT_DIR BOT_VENV BOT_COMMAND BOT_LOG
    
    # Start the bot in background
    su -s /bin/sh "${BOT_USER}" -c "cd '${BOT_DIR}' && export PYTHONPATH='${BOT_DIR}/src' && exec '${BOT_VENV}/bin/python' -m futures_bot.main ${BOT_COMMAND}" >> "${BOT_LOG}" 2>&1 &
    
    local pid=$!
    echo "${pid}" > "${pidfile}"
    sleep 1
    
    # Verify process is still running
    if kill -0 "${pid}" 2>/dev/null; then
        eend 0
        return 0
    else
        rm -f "${pidfile}"
        eend 1 "Failed to start"
        return 1
    fi
}

stop() {
    ebegin "Stopping ${description}"
    
    if [ ! -f "${pidfile}" ]; then
        eend 0 "Not running"
        return 0
    fi
    
    local pid=$(cat "${pidfile}")
    if kill -0 "${pid}" 2>/dev/null; then
        kill "${pid}"
        # Wait for graceful shutdown (up to 10 seconds)
        local count=0
        while kill -0 "${pid}" 2>/dev/null && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done
        # Force kill if still running
        if kill -0 "${pid}" 2>/dev/null; then
            kill -9 "${pid}" 2>/dev/null
        fi
    fi
    
    rm -f "${pidfile}"
    eend 0
}

status() {
    ebegin "Checking ${description}"
    
    if [ ! -f "${pidfile}" ]; then
        einfo "Not running (no pidfile)"
        return 1
    fi
    
    local pid=$(cat "${pidfile}")
    if kill -0 "${pid}" 2>/dev/null; then
        einfo "Running (PID ${pid})"
        return 0
    else
        einfo "Not running (stale pidfile)"
        rm -f "${pidfile}"
        return 1
    fi
}

