[Unit]
Description=Binance Futures Bot (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/github/binance-futures-bot
Environment=PYTHONPATH=/home/YOUR_USER/github/binance-futures-bot/src
ExecStart=/usr/bin/bash -lc 'exec /home/YOUR_USER/github/binance-futures-bot/.venv/bin/python -m futures_bot.main %i'
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/YOUR_USER/github/binance-futures-bot/data

[Install]
WantedBy=multi-user.target
